# Provider keys — a provider's models are disabled in the UI until its key is set.
SARVAM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Access gate. When set, every page and API route requires this password.
# Production refuses to serve the API without it unless ALLOW_PUBLIC=1.
APP_PASSWORD=
# Optional HMAC secret for the session cookie (defaults to one derived from APP_PASSWORD).
AUTH_SECRET=
# ALLOW_PUBLIC=1

# Used only by `npm run e2e:deployed` against a protected preview deployment.
# VERCEL_AUTOMATION_BYPASS_SECRET=
